# Server
SERVER_PORT=10080
SERVER_MODE=debug
SERVER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:10080

# Database
DB_HOST=localhost
DB_PORT=15433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shuangtang
DB_SSLMODE=disable

# JWT
JWT_SECRET=change-this-to-a-very-long-random-string
JWT_EXPIRY_HOURS=72

# SMTP（QQ邮箱示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_auth_code
SMTP_FROM=your_email@qq.com

# Admin
ADMIN_EMAIL=admin@shuangtang.app
ADMIN_PASSWORD=admin123456

# i18n
DEFAULT_LANG=zh

# Logging
LOG_LEVEL=debug
