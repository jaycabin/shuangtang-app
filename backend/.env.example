# Server
SERVER_PORT=10080
SERVER_MODE=debug
SERVER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:10080

# Database
DB_HOST=localhost
DB_PORT=15432
DB_USER=shuangtang
DB_PASSWORD=shuangtang_secret
DB_NAME=shuangtang
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=shuangtang
MINIO_SECRET_KEY=shuangtang_secret
MINIO_BUCKET=shuangtang
MINIO_USE_SSL=false

# File Storage (local or minio)
FILE_STORAGE=local
LOCAL_STORAGE_PATH=./uploads

# JWT
JWT_SECRET=change-this-to-a-very-long-random-string
JWT_EXPIRY_HOURS=72

# SMTP (configure via admin panel, fallback env vars)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shuangtang.app

# Admin
ADMIN_EMAIL=admin@shuangtang.app
ADMIN_PASSWORD=admin123456

# i18n
DEFAULT_LANG=zh

# Logging
LOG_LEVEL=debug
